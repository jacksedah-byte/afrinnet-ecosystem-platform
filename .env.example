# Frontend values; Convex deployment variables are configured with `npx convex env set`.
# Convex deployment URL (the deployment's .convex.cloud URL, not the website URL)
VITE_CONVEX_URL=

# Clerk publishable key for the /cms sign-in
VITE_CLERK_PUBLISHABLE_KEY=

# Generated and managed by `npx convex dev`
CONVEX_DEPLOYMENT=
