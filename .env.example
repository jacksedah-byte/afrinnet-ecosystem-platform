# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to configure the development deployment
VITE_CONVEX_URL=

# Clerk publishable key from the Clerk application dashboard
VITE_CLERK_PUBLISHABLE_KEY=

# Public canonical website origin. Production defaults to https://afrinnet.com.
VITE_SITE_URL=
# Set by the public-only launch build; leave unset for the full Clerk/CMS build.
VITE_PUBLIC_LAUNCH_MODE=

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Set these in the Convex deployment environment, not in client-side Vite vars:
# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-issuer-domain
# CMS_ADMIN_USER_IDS=user_...,user_...
# RESEND_API_KEY=...
# AFRINNET_NOTIFICATION_EMAIL=team@example.org
# AFRINNET_FROM_EMAIL=AFRINNET <notifications@example.org>
# AFRINNET_SITE_URL=https://your-confirmed-site-origin.example
# AFRINNET_CONVEX_SITE_URL=https://your-deployment.convex.site
