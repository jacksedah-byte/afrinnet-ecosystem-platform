# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to configure the development deployment
VITE_CONVEX_URL=

# Clerk publishable key from the Clerk application dashboard
VITE_CLERK_PUBLISHABLE_KEY=

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Set these in the Convex deployment environment, not in client-side Vite vars:
# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-issuer-domain
# CMS_ADMIN_USER_IDS=user_...,user_...
